{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LiquidVoice",
  "version": "0.1.0",
  "identifier": "com.sucra.liquidvoice",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "overlay",
        "title": "LiquidVoice",
        "width": 460,
        "height": 90,
        "x": 0,
        "y": 4,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "focusable": false,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false,
        "url": "/"
      },
      {
        "label": "settings",
        "title": "LiquidVoice Settings",
        "width": 380,
        "height": 520,
        "resizable": true,
        "skipTaskbar": true,
        "visible": false,
        "url": "/settings",
        "minWidth": 320,
        "minHeight": 420
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
